.uploads

# Build output of the API
server-dist

# TanStack Router writes transient route-generation scratch files here.
.tanstack/

# Throwaway harness scripts used to drive the test database during a session.
# They carry the test-account password and are rewritten constantly, so they
# are deliberately not part of the project — least of all a public one.
.e2e-*.mts
.repro.mts

# Where production lives — address, account, directory layout. Not secret, but
# this repository is public and there is no reason to publish the floor plan.
# See deploy.config.example.sh.
#
# The GLOB, not the exact name. A timestamped backup — deploy.config.sh.bak-…
# — is the same floor plan under a name the exact-match rule did not cover, and
# `git add -A` published one to a public repository. Anything that starts with
# this name is the same file.
deploy.config.sh*

# Backups of anything, for the same reason. `.env.bak-…` would be far worse.
*.bak-*
