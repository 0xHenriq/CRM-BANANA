# Runtime connection. MUST be the bd_app role: it is a non-owner, non-superuser
# with rolbypassrls = false, which is what makes the RLS policies binding.
DATABASE_URL=postgres://bd_app:CHANGEME@127.0.0.1:55432/bd_portal

# Migrations only. bd_owner owns the schema; the app never connects as this.
DATABASE_URL_OWNER=postgres://bd_owner:CHANGEME@127.0.0.1:55432/bd_portal

PORT=4300
NODE_ENV=development
LOG_LEVEL=debug

# 'true' only when served over HTTPS, or every login silently fails.
COOKIE_SECURE=false

MAX_SEATS=10
UPLOAD_DIR=./.uploads

# Public origin; Better Auth derives callbacks from it.
APP_URL=http://localhost:5173

# openssl rand -base64 48 — rotating this invalidates every session.
BETTER_AUTH_SECRET=CHANGEME_min_32_chars

TEST_DATABASE_URL=postgres://bd_app:CHANGEME@127.0.0.1:55432/bd_portal_test
TEST_DATABASE_URL_OWNER=postgres://bd_owner:CHANGEME@127.0.0.1:55432/bd_portal_test

# Stripe. Optional — without them the Pay buttons answer 503 with a sentence
# saying what is missing, and the rest of the portal works untouched.
#
# STRIPE_SECRET_KEY is from the API keys page. STRIPE_WEBHOOK_SECRET is NOT —
# it belongs to the webhook endpoint you create, and each endpoint has its own.
# Without it the webhook refuses to run at all: an unverified webhook is an
# open endpoint that writes payment rows.
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME
