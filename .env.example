# Runtime connection. MUST be the bd_app role: it is a non-owner, non-superuser
# with rolbypassrls = false, which is what makes the RLS policies binding.
DATABASE_URL=postgres://bd_app:CHANGEME@127.0.0.1:55432/bd_portal

# Migrations only. bd_owner owns the schema; the app never connects as this.
DATABASE_URL_OWNER=postgres://bd_owner:CHANGEME@127.0.0.1:55432/bd_portal

PORT=4300
NODE_ENV=development
LOG_LEVEL=debug

# 'true' only when served over HTTPS, or every login silently fails.
COOKIE_SECURE=false

MAX_SEATS=10
UPLOAD_DIR=./.uploads
